    "modmenu": ["com.quantcraft.QuantCraftModMenuIntegration"]
  },
  "mixins": ["quantcraft.mixins.json", "quantcraft.client.mixins.json"],
  "depends": {
    "fabricloader": ">=0.15.0",
    "fabric-api": "*",
    "minecraft": "~1.20.4",
    "java": ">=17",
    "modmenu": ">=9.0.0",
    "cloth-config": "*"
  }
}
